# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Poetry
# Ignore the virtual environment if it's inside the project (not recommended though)
.env
.venv/
poetry.lock

# Django specific
*.log
*.pot
*.pyc
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/
local_settings.py

# VS Code settings (optional, if you use VSCode)
.vscode/

# macOS system files
.DS_Store

# Testing / Coverage
htmlcov/
.coverage
.tox/
.nox/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/

# Migrations (optional: sometimes you ignore autogenerated migrations at early stages)
# **Be careful!** Usually you want to keep migration files in production.
# Uncomment the next line only if you know what you're doing:
# */migrations/*.py
# */migrations/*.pyc

# Node (optional: if you have frontend assets built by npm/yarn)
node_modules/

# dotenv environment files (you usually keep .env files local)
.env
.env.*

# MyPy and other Python tool caches
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Celery beat schedule file
celerybeat-schedule

# SQLite3 (alternative dbs during dev)
*.sqlite3

